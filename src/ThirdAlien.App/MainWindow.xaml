<Window x:Class="ThirdAlien.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="The Third Alien" Width="1320" Height="800" MinWidth="960" MinHeight="600"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel LastChildFill="True" Margin="16">
        <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StatusBarItem Content="{Binding SelectionSummary}" />
            <Separator />
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding AddFilesCommand}" ToolTip="Add supported local audio files"><StackPanel Orientation="Horizontal"><icons:FluentIcon Icon="FolderOpen" IconSize="Size20" Margin="0,0,7,0" /><TextBlock Text="Add files" /></StackPanel></Button>
                    <Button Command="{Binding StageChangesCommand}" ToolTip="Preview changes for the selected file"><StackPanel Orientation="Horizontal"><icons:FluentIcon Icon="Edit" IconSize="Size20" Margin="0,0,7,0" /><TextBlock Text="Stage changes" /></StackPanel></Button>
                    <Button Command="{Binding SaveStagedChangesCommand}" ToolTip="Write verified changes and make a backup"><StackPanel Orientation="Horizontal"><icons:FluentIcon Icon="Save" IconSize="Size20" Margin="0,0,7,0" /><TextBlock Text="Save staged" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Theme" />
                    <ComboBox Width="112" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
            </DockPanel>
            <Border Background="{DynamicResource PanelBackground}" Padding="12" CornerRadius="6" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Find an album" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Height="30" Margin="0" Padding="8,0" VerticalContentAlignment="Center" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Command="{Binding SearchAlbumsCommand}" Margin="12,0"><StackPanel Orientation="Horizontal"><icons:FluentIcon Icon="Search" IconSize="Size20" Margin="0,0,7,0" /><TextBlock Text="Search iTunes" /></StackPanel></Button>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="Search finds music albums; select one to load its tracks before matching." />
                </Grid>
            </Border>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="12" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBackground}" Padding="8" CornerRadius="6">
                <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="1" SelectionChanged="Files_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.Header><CheckBox IsChecked="{Binding DataContext.AllFilesSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" ToolTip="Select or clear all files" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelectedForAlbum, Mode=TwoWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Snapshot.Metadata.Title}" Width="2*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Snapshot.Metadata.Artist}" Width="2*" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Snapshot.Metadata.Album}" Width="2*" />
                        <DataGridTextColumn Header="Track" Binding="{Binding Snapshot.Metadata.TrackNumber}" Width="Auto" />
                        <DataGridTextColumn Header="Format" Binding="{Binding Snapshot.Properties.Format}" Width="Auto" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource PanelBackground}" Padding="16" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0" HorizontalAlignment="Stretch">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Edit selected file" />
                        <TextBlock Margin="0,2,0,12" Foreground="{DynamicResource MutedForegroundBrush}" Text="Stage text changes first; choosing artwork saves and verifies the cover immediately." TextWrapping="Wrap" />
                        <Button Command="{Binding ChooseArtworkCommand}" Width="176" Height="176" Padding="0" Margin="0" HorizontalAlignment="Center" ToolTip="Choose a front-cover image for the selected file">
                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                                <Grid>
                                    <Image Source="{Binding FrontCoverImage}" Stretch="UniformToFill" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasFrontCover}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <icons:FluentIcon Icon="ImageAdd" IconSize="Size32" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,6,0,0" Text="Click to choose cover" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                        <TextBlock Margin="0,8,0,12" HorizontalAlignment="Center" Foreground="#FF707070" Text="Selected artwork: 600 x 600 request" />
                        <StackPanel IsEnabled="{Binding HasSelectedFile}">
                            <Label Content="Title" /><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Track artist" /><TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Album" /><TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Album artist" /><TextBox Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Genre" /><TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Composer" /><TextBox Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Content="Year" /><TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><Label Content="Track / total" /><TextBox Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}" /><TextBox Text="{Binding TrackTotal, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel><Label Content="Disc / total" /><TextBox Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}" /><TextBox Text="{Binding DiscTotal, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </UniformGrid>
                            <Label Content="Unsynchronized lyrics" /><TextBox Text="{Binding Lyrics, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <Button Command="{Binding OpenFullTagsCommand}" HorizontalAlignment="Left" Margin="0,2,0,0"><StackPanel Orientation="Horizontal"><icons:FluentIcon Icon="Document" IconSize="Size20" Margin="0,0,7,0" /><TextBlock Text="Full tags" /></StackPanel></Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource PanelBackground}" Padding="8" CornerRadius="6">
                <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedAlbum}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" FrozenColumnCount="1">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Load" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Load tracks" Command="{Binding DataContext.LoadAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cover" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Width="48" Height="48" Source="{Binding ArtworkUrl}" Stretch="UniformToFill" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Name}" Width="3*" />
                        <DataGridTextColumn Header="Release" Binding="{Binding ReleaseDate}" Width="Auto" />
                        <DataGridTextColumn Header="Tracks" Binding="{Binding TrackCount}" Width="Auto" />
                        <DataGridTextColumn Header="Store" Binding="{Binding Storefront}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>