<Window x:Class="ThirdAlien.App.FullTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full tags" Width="760" Height="600" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource ForegroundBrush}">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Add" Click="Add_Click" />
                <Button Content="Edit" Click="Edit_Click" IsEnabled="{Binding HasSelectedTag}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" />
                <Button Content="Save" Click="Save_Click" IsDefault="True" Margin="0" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="{DynamicResource MutedForegroundBrush}" Text="Inspect and edit every readable tag. Add custom fields using the field names supported by your audio format." TextWrapping="Wrap" />
        <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Tag name" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="ReadName" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBox x:Name="EditName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Margin="0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="ReadName" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="EditName" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="ReadValue" Text="{Binding Value}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBox x:Name="EditValue" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Margin="0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="ReadValue" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="EditValue" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>